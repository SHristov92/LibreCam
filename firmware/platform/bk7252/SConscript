# SCons script for building the A9 application inside Beken's RT-Thread SDK.
# Copy or symlink the firmware/ directory into the SDK's applications/ tree.
# Untested: adjust to the SDK's build layout.
import os
from building import *

cwd = GetCurrentDir()
root = os.path.normpath(os.path.join(cwd, '..', '..'))

# Embed the web UI before compiling.
os.system('python3 "%s" "%s" "%s"' % (
    os.path.join(root, 'tools', 'embed_web.py'),
    os.path.join(root, 'web', 'index.html'),
    os.path.join(cwd, 'web_ui.c')))

src = [os.path.join(root, 'src', f) for f in (
    'app_main.c', 'config.c', 'http_server.c', 'net_compat.c',
    'rtp_jpeg.c', 'rtsp_server.c')]
src += [os.path.join(cwd, 'hal_bk7252.c'), os.path.join(cwd, 'web_ui.c')]

group = DefineGroup('a9_app', src, depend=[''],
                    CPPPATH=[os.path.join(root, 'include')],
                    CPPDEFINES=['A9_PLATFORM_BK7252', 'FRAME_BUF=(48*1024)'])
Return('group')
