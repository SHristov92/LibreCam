# SCons script for building the firmware inside Beken's RT-Thread SDK.
# Copy or symlink the firmware/ directory into the SDK's applications/ tree.
# The board is chosen with the A9_BOARD environment variable.
# Untested: adjust to the SDK's build layout.
import os
from building import *

cwd = GetCurrentDir()
root = os.path.normpath(os.path.join(cwd, '..', '..'))
lib = os.path.join(root, 'lib')
board = os.environ.get('A9_BOARD', 'a9-mini-bk7252')

# Embed the web UI before compiling.
os.system('python3 "%s" "%s" "%s"' % (
    os.path.join(lib, 'tools', 'embed_web.py'),
    os.path.join(lib, 'web', 'index.html'),
    os.path.join(cwd, 'web_ui.c')))

src = [os.path.join(lib, 'src', f) for f in (
    'app_main.c', 'config.c', 'http_server.c', 'net.c',
    'rtp_jpeg.c', 'rtsp_server.c')]
src += [os.path.join(cwd, 'hal_bk7252.c'), os.path.join(cwd, 'web_ui.c')]

group = DefineGroup('a9_app', src, depend=[''],
                    CPPPATH=[os.path.join(lib, 'include'), cwd,
                             os.path.join(root, 'boards', board)])
Return('group')
